# ==============================================================================
# VIBE VAULT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production (Render, Railway, Fly.io, etc.) set these as environment
# variables in your platform dashboard — do NOT commit .env with real values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask — Security
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SECRET_KEY=your_generated_64_char_hex_secret_key_here

# ------------------------------------------------------------------------------
# Database — PostgreSQL
#
# Production (Render):
#   Render automatically injects DATABASE_URL when you attach a PostgreSQL
#   database to your service. You do NOT need to set it manually.
#
# Local development:
#   Option A — Set DATABASE_URL directly (recommended):
#     DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/vibe_vault
#
#   Option B — Set individual vars (DATABASE_URL will be built from these):
#     DB_HOST=localhost
#     DB_PORT=5432
#     DB_USER=postgres
#     DB_PASSWORD=yourpassword
#     DB_NAME=vibe_vault
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/vibe_vault

# Individual vars (only used when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_NAME=vibe_vault

# ------------------------------------------------------------------------------
# Flask runtime settings
# ------------------------------------------------------------------------------
FLASK_DEBUG=0
PORT=5000

# Set to true when serving over HTTPS (always true in Render production)
SESSION_COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# File Storage
#
# IMPORTANT: Render's filesystem is EPHEMERAL.
# Files saved to uploads/ will be LOST on every deploy or restart.
# For persistent music and image storage, use S3-compatible object storage:
#   - Cloudflare R2 (free egress, recommended)
#   - AWS S3
#   - Backblaze B2
#   - MinIO (self-hosted)
#
# Set STORAGE_BACKEND=s3 and fill in the S3_* variables below.
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local

# S3-Compatible Object Storage (required only when STORAGE_BACKEND=s3)
# S3_BUCKET_NAME=your-vibevault-bucket
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_REGION=auto
