# ==============================================================================
# VIBE VAULT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace placeholders with your actual production values.
# DO NOT commit .env with real credentials to version control.
# ==============================================================================

# Flask Session & Security (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_generated_32_byte_hex_secret_key_here

# Database Configuration (Managed MySQL e.g. Railway, PlanetScale, AWS RDS, DigitalOcean)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=vibe_vault

# Optional: Set to true only for local zero-dependency testing without MySQL
USE_SQLITE=false

# Security: Set to true in production when serving behind HTTPS / SSL
SESSION_COOKIE_SECURE=true

# Server Runtime Port (PaaS platforms like Render/Railway automatically inject PORT)
PORT=5000

# Flask Debug Mode (Set to 0 or false in production)
FLASK_DEBUG=0

# ==============================================================================
# File Storage Configuration (Optional S3-Compatible Object Storage)
# ==============================================================================
# Set to 'local' (default) or 's3' (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_BACKEND=local

# S3 Configuration (Required only when STORAGE_BACKEND=s3)
# S3_BUCKET_NAME=your-bucket-name
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_REGION=us-east-1
